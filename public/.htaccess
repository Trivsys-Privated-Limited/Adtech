# Apache rules for the static export on Hostinger. Copied to out/ by `next build`.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# The social preview image is exported without a file extension.
<Files "opengraph-image">
  ForceType image/png
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Build assets have hashed names and never change; pages are rechecked on every visit.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
