# Copy to .env.local and fill in. Never commit real secrets.

# Public production origin (no trailing slash). Enables canonical URLs and
# absolute sitemap/robots/Open Graph URLs.
NEXT_PUBLIC_SITE_URL=

# Server-only: endpoint that receives contact form submissions as JSON
# (CRM, Zapier/Make webhook, Slack workflow, or your own email service).
# When empty, the form shows a "Preview form" notice and tells visitors their
# message was not sent. Read at build time: set it before `npm run build`.
CONTACT_WEBHOOK_URL=

# Optional server-only secret, sent as "Authorization: Bearer <secret>".
CONTACT_WEBHOOK_SECRET=

# Server-only: endpoint that receives newsletter sign-ups as JSON (e.g. a
# Zapier/Make webhook into your email platform, or your own endpoint). When
# empty, the sign-up form shows a "Preview" notice and tells visitors they
# were not subscribed. Read at build time: set it before `npm run build`.
NEWSLETTER_WEBHOOK_URL=

# Optional server-only secret, sent as "Authorization: Bearer <secret>".
NEWSLETTER_WEBHOOK_SECRET=
